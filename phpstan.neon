parameters:
    level: 2
    paths:
        - .
    excludePaths:
        analyseAndScan:
            - vendor (?)
            - node_modules (?)
    bootstrapFiles:
        # Falls deine App eine Bootstrap-Datei hat, hier eintragen.
        # Alternativ definieren wir Konstanten hier direkt oder über ein Stubs-File:
    stubFiles:
        - phpstan-stubs.php
